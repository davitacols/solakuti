# Copy to deploy/.env.prod and fill in. Used both for compose variable
# substitution and as the backend container's env_file.
# docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.prod ...

# --- Postgres (compose) ---
POSTGRES_DB=solakuti
POSTGRES_USER=solakuti
POSTGRES_PASSWORD=change-me-long-random
SPORTS_DB=solakuti_sports

# --- Django core ---
SECRET_KEY=change-me-64-random-chars
DJANGO_DEBUG=False
ALLOWED_HOSTS=www.solakuti.com,solakuti.com
CORS_ALLOWED_ORIGINS=https://www.solakuti.com,https://solakuti.com
CSRF_TRUSTED_ORIGINS=https://www.solakuti.com,https://solakuti.com
FRONTEND_URL=https://www.solakuti.com
SECURE_SSL_REDIRECT=False

# --- Databases (point at the db service; names match POSTGRES_DB / SPORTS_DB) ---
DATABASE_URL=postgresql://solakuti:change-me-long-random@db:5432/solakuti
SPORTS_DATABASE_URL=postgresql://solakuti:change-me-long-random@db:5432/solakuti_sports

# --- Media: self-hosted on the VPS ---
MEDIA_PROVIDER=local
MEDIA_ROOT=/app/mediafiles
MEDIA_URL=https://www.solakuti.com/media/

# --- Cloudinary: keep set until the image migration is done (used to pull originals) ---
CLOUDINARY_CLOUD_NAME=dlx1jekov
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Sports provider (used by the cron sync jobs) ---
API_FOOTBALL_API_KEY=
API_FOOTBALL_SEASON=

# --- Frontend build args (NEXT_PUBLIC_* are inlined at build time) ---
NEXT_PUBLIC_API_URL=https://www.solakuti.com/api
NEXT_PUBLIC_SITE_URL=https://www.solakuti.com
NEXT_PUBLIC_API_TIMEOUT_MS=20000
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-65J729EGYG
NEXT_PUBLIC_ADSENSE_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_SLOT_HOME_MID=4813321477
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MID=1411612607
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY_MID=7216123530
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY_SIDEBAR=4589960199

# --- Maintenance toggle (frontend middleware, read at runtime) ---
MAINTENANCE_MODE=off
MAINTENANCE_BYPASS_TOKEN=
