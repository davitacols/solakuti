SECRET_KEY=replace-me-with-a-long-random-secret
DJANGO_DEBUG=False
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,solakuti-1.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://solakuti.com,https://www.solakuti.com,https://solakuti.vercel.app
FRONTEND_URL=https://solakuti.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://solakuti.com,https://www.solakuti.com,https://solakuti.vercel.app,https://solakuti-1.onrender.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800
# Optional. Test carefully before enabling because strict CSP can block admin/docs assets.
CONTENT_SECURITY_POLICY=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solakuti
# Optional: put LiveScore data in a separate database so sports sync does not consume the main newsroom DB quota.
SPORTS_DATABASE_URL=

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# LiveScore provider.
# Use api_football for API-Football/API-SPORTS, or football_data for football-data.org.
SPORTS_PROVIDER=api_football
API_FOOTBALL_API_KEY=your-api-football-key
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_COMPETITIONS=PL,CL,BL1,DED,BSA,PD,FL1,ELC,PPL,EC,SA,WC
# European seasons use their start year. Example: 2025 for the 2025/26 season.
API_FOOTBALL_SEASON=2025
API_FOOTBALL_SYNC_DETAILS=True
API_FOOTBALL_TIMEOUT_SECONDS=35
API_FOOTBALL_MAX_ATTEMPTS=3

# Legacy/free provider fallback. Get a token at https://www.football-data.org/
FOOTBALL_DATA_API_KEY=your-football-data-api-key
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_COMPETITIONS=WC,CL,BL1,DED,BSA,PD,FL1,ELC,PPL,EC,SA,PL
