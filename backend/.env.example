SECRET_KEY=replace-me-with-a-long-random-secret
DJANGO_DEBUG=False
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,solakuti-1.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://solakuti.com,https://www.solakuti.com,https://solakuti.vercel.app
